# 없으면 규칙 기반 폴백 문구로 동작합니다.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# MySQL 접속 정보 (이 파일을 .env.local 로 복사해 값을 채우세요. .env.local 은 git 에 올리지 않습니다)
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
# TiDB Cloud 등 TLS 를 요구하는 DB 는 true (TiDB 는 포트 4000)
DB_SSL=false
# 실데이터 CSV 를 적재할 새 테이블 이름
DB_TABLE=customers_real
# 적재할 CSV 경로 (생략하면 기본 경로 사용)
# CSV_PATH=C:/projects/mini-project/feature_df/data/integrated_feature_df.csv
